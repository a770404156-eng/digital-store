# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.

# --- App / store identity (Phase 1+) ---
# Used later to load per-store config (name, theme, etc.) when we set up multi-client support.
NEXT_PUBLIC_STORE_SLUG=

# --- Database (Phase 3 — Supabase Postgres) ---
DATABASE_URL=
DIRECT_URL=

# --- Supabase (Phase 3 / Phase 8) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Image storage (Phase 5 — Cloudinary) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Google Sheets order export (Phase 7) ---
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=